#!/usr/bin/env python3
# Minifica styles.css e inyecta el resultado entre los marcadores
# CSS-INLINE:START / CSS-INLINE:END de cada pagina que los tenga.
# Uso: python scripts/build-css

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STYLES = ROOT / "styles.css"
MARK_START = "<!-- CSS-INLINE:START -->"
MARK_END = "<!-- CSS-INLINE:END -->"
FINGERPRINT = re.compile(r"--head-font\s*:\s*'Montserrat'")


def minify(css: str) -> str:
    strings = []

    def protect(m):
        strings.append(m.group(0))
        return f"@@STR{len(strings) - 1}@@"

    css = re.sub(r"'[^']*'|\"[^\"]*\"", protect, css)
    css = re.sub(r"/\*.*?\*/", "", css, flags=re.DOTALL)
    css = re.sub(r"\s+", " ", css)
    css = re.sub(r"\s*([{}:;,])\s*", r"\1", css)
    css = re.sub(r";}", "}", css)
    css = css.strip()

    for i, s in enumerate(strings):
        css = css.replace(f"@@STR{i}@@", s)
    return css


def main() -> int:
    if not STYLES.exists():
        print(f"ERROR: no se encuentra {STYLES}", file=sys.stderr)
        return 1

    minified = minify(STYLES.read_text(encoding="utf-8"))
    replacement = f"{MARK_START}\n  <style>{minified}</style>\n  {MARK_END}"
    pattern = re.compile(re.escape(MARK_START) + r".*?" + re.escape(MARK_END), re.DOTALL)

    modified, unchanged, warnings = [], [], []

    for path in sorted(ROOT.rglob("*.html")):
        if "node_modules" in path.parts:
            continue
        text = path.read_text(encoding="utf-8")
        rel = path.relative_to(ROOT)
        has_start, has_end = MARK_START in text, MARK_END in text

        if has_start and has_end:
            new_text, n = pattern.subn(replacement, text)
            if n != 1:
                warnings.append(f"{rel}: {n} pares de marcadores (se esperaba 1), no tocado")
                continue
            if new_text != text:
                path.write_text(new_text, encoding="utf-8")
                modified.append(rel)
            else:
                unchanged.append(rel)
        elif has_start or has_end:
            warnings.append(f"{rel}: tiene solo uno de los dos marcadores, no tocado")
        elif FINGERPRINT.search(text):
            warnings.append(f"{rel}: parece llevar el CSS compartido pero sin marcadores, no tocado")

    size = len(minified.encode("utf-8"))
    print(f"styles.css minificado: {size} bytes ({size / 1024:.1f} KiB)")
    print(f"Archivos actualizados ({len(modified)}):")
    for p in modified:
        print(f"  {p}")
    print(f"Archivos ya al dia: {len(unchanged)}")
    if warnings:
        print("Avisos:")
        for w in warnings:
            print(f"  ! {w}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
