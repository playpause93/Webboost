{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "webboost.es" }],
      "destination": "https://www.webboost.es/$1",
      "permanent": true
    },
    {
      "source": "/blog/seo-la-rioja",
      "destination": "/seo-la-rioja",
      "permanent": true
    }
  ]
}
